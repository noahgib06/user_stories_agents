{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrateur",
  "instructions": ["AGENTS.md"],
  // Règles ordonnées : la dernière correspondance gagne. Les règles des agents s'ajoutent après.
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "python3 -m ivq status *", "effect": "allow" },
    { "action": "shell", "resource": "python3 -m ivq validate *", "effect": "allow" },
    { "action": "shell", "resource": "python3 -m ivq audit-verify *", "effect": "allow" },
  ],
}
