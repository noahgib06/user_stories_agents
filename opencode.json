{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrateur",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": "deny",
    "webfetch": "deny",
    "bash": {
      "*": "deny",
      "python3 -m ivq status": "allow",
      "python3 -m ivq validate": "allow",
      "python3 -m ivq audit-verify": "allow"
    }
  }
}
